# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# Production Gmail SMTP Email Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
APP_URL=http://localhost:5173

# Groq LLM API Key (Optional)
GROQ_API_KEY=your-groq-api-key

# JWT Secret Key
JWT_SECRET_KEY=pharmacast-super-secret-production-key-2026-xyz!
